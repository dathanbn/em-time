{
  "name": "em-time",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Em Time: a calm focus timer PWA.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "npm run icons && tsc --noEmit && vite build --config frontend/vite.config.ts",
    "postbuild": "node scripts/check-size.mjs",
    "preview": "vite preview --config frontend/vite.config.ts --port 4173",
    "icons": "pwa-assets-generator --config frontend/pwa-assets.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "@supabase/supabase-js": "^2.117.3",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
